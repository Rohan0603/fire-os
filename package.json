{
  "name": "fire-os",
  "version": "3.0.0",
  "description": "A comprehensive personal finance dashboard for FIRE (Financial Independence, Retire Early) planning with TypeScript + Vite. Track investments, simulate market crashes, calculate retirement timelines, and manage tax-efficient strategies.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/prerender-routes.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "//": "check runs the fast local gate in CI order (quality.yml): build, lint, format:check, unit tests, worker tests, then route metadata. test:rules:emulator, test:e2e and test:http are left out because they need the Firebase emulator, a Playwright browser plus a preview server, and a running preview server respectively. Run those individually or let CI cover them.",
    "check": "npm run build && npm run lint && npm run format:check && npm test && npm run test:worker && npm run test:metadata",
    "test:metadata": "node scripts/verify-routes.mjs",
    "test:http": "node scripts/verify-http.mjs",
    "test": "vitest run --exclude=**/firestore.rules.test.ts",
    "test:watch": "vitest",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "deploy:worker": "npx --yes wrangler@latest deploy --config worker/wrangler.toml",
    "test:rules": "vitest run src/lib/firestore.rules.test.ts",
    "test:rules:emulator": "node scripts/test-firestore-rules-emulator.mjs",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rohan0603/fire-os.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Rohan0603/fire-os/issues"
  },
  "homepage": "https://github.com/Rohan0603/fire-os#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^4.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "terser": "^5.48.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-tooltip": "^1.3.0",
    "date-fns": "^4.4.0",
    "deep-chat": "^2.5.1",
    "firebase": "^11.0.0",
    "nanostores": "^1.5.4",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "xirr": "^1.1.0",
    "zod": "^4.6.5"
  }
}
