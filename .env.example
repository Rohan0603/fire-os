# Frontend: public Firebase configuration. API keys are restricted in Firebase.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=fire-os-dd6d6.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fire-os-dd6d6
VITE_FIREBASE_STORAGE_BUCKET=fire-os-dd6d6.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-sender-id
VITE_FIREBASE_APP_ID=1:824527645307:web:7dc209d225e8280d17d0de
VITE_FIREBASE_MEASUREMENT_ID=replace-with-measurement-id
VITE_CORSPROXY_API_KEY=replace-with-corsproxy-key
VITE_ASSISTANT_API_URL=https://fire-os-assistant.fire-os.workers.dev

# Assistant backend runs on Cloudflare Workers; the API key is a Worker secret,
# never a VITE_* or .env value. Local Worker development: put OPENROUTER_API_KEY
# in .dev.vars (gitignored) and run `npx wrangler dev --config worker/wrangler.toml`.

# Optional local test settings.
E2E_EMAIL=replace-with-test-email
E2E_PASSWORD=replace-with-test-password
FIRESTORE_EMULATOR_PORT=8082