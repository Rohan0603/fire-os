{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "portfolio": {
          ".validate": "newData.hasChildren(['version', 'timestamp', 'profile', 'holdings'])",
          "version": {
            ".validate": "newData.val() === '2'"
          },
          "timestamp": {
            ".validate": "newData.isString()"
          },
          "profile": {
            ".validate": "newData.isObject()"
          },
          "holdings": {
            ".validate": "newData.isObject()"
          }
        }
      }
    }
  }
}
